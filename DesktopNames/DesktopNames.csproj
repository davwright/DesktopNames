<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.2.51</Version>
    <!-- publish.ps1 supplies the short sha (plus .dirty). Without this the SDK appends the
         full sha again, turning "1.2.19+c13a95c" into "1.2.19+c13a95c.c13a95c5b57...". -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Catch AccessViolationException from undocumented Win11 virtual-desktop COM calls
         so a vtable-mismatch on a non-load-bearing call (e.g. MoveViewToDesktop) can't
         kill the process. Without this, AVs are unhandled and Windows terminates the app. -->
    <LegacyCorruptedStateExceptionsPolicy>true</LegacyCorruptedStateExceptionsPolicy>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
    <EmbeddedResource Include="vscode.ico" />
    <EmbeddedResource Include="claude.ico" />
    <None Include="VirtualDesktopAccessor.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>